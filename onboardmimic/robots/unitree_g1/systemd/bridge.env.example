# Copy to ~/.config/onboardmimic/bridge.env and set your own installed paths.
ROS_SETUP=/opt/ros/foxy/setup.bash
UNITREE_ROS_SETUP=/path/to/unitree_ros2/install/setup.bash
CYCLONEDDS_URI=file:///path/to/cyclonedds.xml
# Native bridge/readers use the ROS2 C++ runtime above.
# 原生桥接和反馈接收器使用上述 ROS2 C++ 运行库。
# Explicit connection also requires ROS2 rclpy / unitree_api for MotionSwitcher.
# 显式连接还需要上述工作空间提供 rclpy / unitree_api 运动模式接口。
# Relay/checks use the repository .venv; BRIDGE_PYTHON/PYTHONPATH are not needed.
# relay 和检查程序使用工程 .venv，无需配置 BRIDGE_PYTHON/PYTHONPATH。
